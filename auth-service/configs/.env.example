# Шаблон. Файл со значениями (configs/.env) в git не хранится.
#   cp configs/.env.example configs/.env

PORT=44044
TOKEN_TTL=1h
STORAGE_PATH=postgres://admin:1234@localhost:5432/auth?sslmode=disable

# Секрет подписи JWT. Локально можно сгенерировать:  openssl rand -hex 32
# В k8s подаётся Secret'ом и монтируется в configs/.env — не кладётся в образ.
SECRET=
